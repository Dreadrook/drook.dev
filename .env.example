# Credentials for the dev-only admin panel at http://localhost:3000/admin
#
# Generate these with:  npm run admin:password
# They belong in .env.local (git-ignored) and are never needed in production —
# the admin panel is not part of the deployed static build.

# Login name (optional, defaults to "admin")
ADMIN_USERNAME=admin

# scrypt hash of your password, format: scrypt:N:r:p:saltBase64Url:keyBase64Url
# (colon-separated on purpose — Next expands `$name` inside .env values)
ADMIN_PASSWORD_HASH=

# Random value (>= 32 chars) used to sign the admin session cookie
ADMIN_SESSION_SECRET=
